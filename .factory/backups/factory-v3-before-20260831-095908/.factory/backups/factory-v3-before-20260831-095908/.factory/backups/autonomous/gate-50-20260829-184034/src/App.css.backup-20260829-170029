* {
  box-sizing: border-box;
}

html {
  background: #f7f8fa;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f7f8fa;
  color: #111827;
}

button,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.factory {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 75% 0%, rgba(99, 102, 241, .06), transparent 32%),
    #f7f8fa;
}

.sidebar {
  width: 250px;
  min-height: 100vh;
  border-right: 1px solid #e7e9ee;
  padding: 24px 18px;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, .92);
}

.brand {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-bottom: 28px;
}

.brandMark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: #111827;
  color: #fff;
  font-weight: 900;
  box-shadow: 0 8px 20px rgba(17, 24, 39, .15);
}

.brand strong,
.brand span {
  display: block;
}

.brand strong {
  font-size: 15px;
  color: #111827;
}

.brand span {
  color: #8b93a1;
  font-size: 12px;
  margin-top: 2px;
}

.newApp {
  border: 1px solid #e2e5eb;
  background: #fff;
  color: #111827;
  padding: 12px;
  border-radius: 11px;
  text-align: left;
  margin-bottom: 28px;
  font-weight: 700;
  transition: .2s ease;
  box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
}

.newApp:hover {
  border-color: #cbd5e1;
  transform: translateY(-1px);
}

.newApp span {
  margin-right: 8px;
}

nav a {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 11px 12px;
  border-radius: 9px;
  color: #7b8492;
  margin: 3px 0;
  font-size: 13px;
  text-decoration: none;
}

nav a span {
  width: 18px;
  text-align: center;
}

nav a.active {
  color: #111827;
  background: #f0f2f5;
  font-weight: 700;
}

.navSection,
.panelEyebrow,
.eyebrow {
  font-size: 10px;
  letter-spacing: .14em;
  color: #9299a6;
  font-weight: 800;
}

.navSection {
  padding: 0 12px 8px;
}

.sidebarBottom {
  margin-top: auto;
}

.localAI {
  border: 1px solid #e6e8ed;
  background: #fff;
  border-radius: 12px;
  padding: 12px;
  display: flex;
  gap: 9px;
  align-items: center;
  box-shadow: 0 5px 20px rgba(15, 23, 42, .04);
}

.localAI strong,
.localAI small {
  display: block;
}

.localAI strong {
  font-size: 12px;
}

.localAI small {
  color: #858d9b;
  font-size: 10px;
  margin-top: 3px;
}

.localAI .onlineText {
  margin-left: auto;
  font-size: 8px;
  color: #16a34a;
  font-weight: 800;
  letter-spacing: .08em;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  display: inline-block;
  box-shadow: 0 0 0 4px rgba(34, 197, 94, .10);
}

.main {
  flex: 1;
  min-width: 0;
  padding: 28px 40px 60px;
  max-width: 1550px;
  margin: auto;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.topbar h1 {
  margin: 5px 0 0;
  font-size: 25px;
  letter-spacing: -.03em;
}

.connection {
  font-size: 10px;
  letter-spacing: .1em;
  color: #747d8b;
  display: flex;
  gap: 9px;
  align-items: center;
  font-weight: 700;
}

.hero {
  max-width: 980px;
  margin: 62px auto 50px;
  text-align: center;
}

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid #e2e6ec;
  background: #fff;
  color: #697383;
  border-radius: 999px;
  padding: 7px 11px;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .1em;
  box-shadow: 0 5px 20px rgba(15, 23, 42, .04);
  margin-bottom: 18px;
}

.heroBadge span {
  color: #6366f1;
}

.hero h2 {
  font-size: clamp(38px, 5vw, 62px);
  margin: 0;
  letter-spacing: -.055em;
  color: #111827;
}

.hero p {
  color: #737d8c;
  max-width: 700px;
  margin: 17px auto 31px;
  line-height: 1.7;
  font-size: 14px;
}

.promptBox {
  text-align: left;
  border: 1px solid #dfe3e9;
  background: #fff;
  border-radius: 19px;
  padding: 7px;
  box-shadow:
    0 20px 70px rgba(15, 23, 42, .08),
    0 3px 12px rgba(15, 23, 42, .03);
  transition: .2s ease;
}

.promptBox:focus-within {
  border-color: #c8ced9;
  box-shadow:
    0 24px 80px rgba(15, 23, 42, .11),
    0 0 0 4px rgba(99, 102, 241, .05);
}

.promptBox textarea {
  width: 100%;
  min-height: 150px;
  resize: vertical;
  border: 0;
  outline: 0;
  background: #fff;
  color: #111827;
  padding: 20px;
  font-size: 17px;
  line-height: 1.55;
}

.promptBox textarea::placeholder {
  color: #a6adb8;
}

.promptFooter {
  border-top: 1px solid #eef0f3;
  padding: 11px 12px 11px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8a929f;
  font-size: 10px;
}

.promptInfo {
  display: flex;
  gap: 8px;
  align-items: center;
}

.spark {
  color: #6366f1;
}

.separator {
  color: #c3c8d0;
}

.buildButton {
  border: 0;
  border-radius: 10px;
  background: #111827;
  color: #fff;
  padding: 12px 16px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: .2s ease;
  box-shadow: 0 7px 20px rgba(17, 24, 39, .15);
}

.buildButton:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 10px 25px rgba(17, 24, 39, .2);
}

.buildButton:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.buttonArrow {
  font-size: 16px;
}

.examples {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 14px;
}

.examples > span {
  color: #9aa1ad;
  font-size: 10px;
  padding: 8px 4px;
}

.examples button {
  border: 1px solid #e1e5eb;
  background: #fff;
  color: #737d8b;
  border-radius: 20px;
  padding: 7px 10px;
  font-size: 10px;
  transition: .2s ease;
}

.examples button:hover:not(:disabled) {
  border-color: #cbd2dc;
  color: #374151;
  transform: translateY(-1px);
}

.workspace {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18px;
  margin-bottom: 18px;
}

.panel,
.previewPanel {
  border: 1px solid #e4e7ec;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(15, 23, 42, .04);
}

.panelHeader,
.previewHeader {
  min-height: 76px;
  padding: 16px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #eef0f3;
}

.panelHeader h3,
.previewHeader h3 {
  margin: 4px 0 0;
  color: #111827;
  font-size: 15px;
}

.status {
  border: 1px solid #e3e6eb;
  border-radius: 999px;
  padding: 6px 9px;
  font-size: 8px;
  letter-spacing: .08em;
  font-weight: 800;
  color: #737b87;
  display: flex;
  align-items: center;
  gap: 6px;
}

.status.ready .statusDot {
  background: #22c55e;
}

.status.working .statusDot {
  background: #6366f1;
  animation: pulse 1s infinite;
}

.statusDot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.logs {
  padding: 14px 18px 18px;
  min-height: 185px;
}

.log {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 0;
  color: #727c8b;
  font-size: 11px;
}

.logIcon {
  width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border-radius: 6px;
  background: #f4f5f7;
  color: #8b94a2;
  font-size: 9px;
  font-weight: 800;
}

.error {
  margin: 0 18px 18px;
  padding: 11px;
  border-radius: 9px;
  background: #fff1f2;
  border: 1px solid #ffe0e3;
  color: #be123c;
  font-size: 11px;
}

.fileList {
  padding: 10px;
  min-height: 185px;
}

.file {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  color: #586273;
  font-size: 11px;
  border-radius: 8px;
}

.file:hover {
  background: #f7f8fa;
}

.file > span:first-child {
  width: 20px;
  text-align: center;
  color: #6366f1;
}

.fileCount {
  min-width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #f4f5f7;
  color: #737c89;
  font-size: 10px;
  font-weight: 800;
}

.empty {
  min-height: 185px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #a0a7b2;
  text-align: center;
}

.emptyIcon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #f5f6f8;
  color: #9ca3af;
  margin-bottom: 6px;
  font-size: 19px;
}

.empty strong {
  color: #697383;
  font-size: 12px;
}

.empty span {
  font-size: 10px;
}

.previewPanel {
  margin-bottom: 18px;
}

.previewActions {
  display: flex;
  gap: 7px;
}

.previewActions button {
  border: 1px solid #e3e6eb;
  background: #fff;
  color: #687282;
  border-radius: 8px;
  padding: 7px 9px;
  font-size: 10px;
  transition: .2s ease;
}

.previewActions button:hover {
  background: #f7f8fa;
  color: #111827;
}

.previewBrowser {
  background: #eef1f5;
  padding: 12px;
}

.browserBar {
  height: 38px;
  background: #fff;
  border: 1px solid #e1e4e9;
  border-bottom: 0;
  border-radius: 11px 11px 0 0;
  display: flex;
  align-items: center;
  padding: 0 12px;
  gap: 14px;
}

.browserDots {
  display: flex;
  gap: 5px;
}

.browserDots span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #d8dce2;
}

.browserAddress {
  flex: 1;
  max-width: 500px;
  margin: auto;
  height: 24px;
  border-radius: 7px;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #89919e;
  font-size: 9px;
}

.lock {
  color: #22a06b;
}

.browserStatus {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #16a34a;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .08em;
}

.browserStatus .dot {
  width: 6px;
  height: 6px;
  box-shadow: none;
}

.previewFrameWrap {
  background: #fff;
  border: 1px solid #e1e4e9;
  border-radius: 0 0 11px 11px;
  overflow: hidden;
  min-height: 520px;
}

.livePreviewFrame {
  display: block;
  width: 100%;
  height: 520px;
  border: 0;
  background: #fff;
}

.pipeline {
  border: 1px solid #e4e7ec;
  background: #fff;
  border-radius: 16px;
  padding: 18px;
  display: grid;
  grid-template-columns: 1.3fr repeat(5, 1fr);
  gap: 8px;
  box-shadow: 0 8px 30px rgba(15, 23, 42, .04);
}

.pipelineTitle h3 {
  margin: 5px 0 0;
  font-size: 15px;
  color: #111827;
}

.step {
  position: relative;
  min-height: 70px;
  border-left: 1px solid #eef0f3;
  padding: 3px 12px 3px 15px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stepNumber {
  font-size: 8px;
  color: #a1a8b3;
  font-weight: 800;
  letter-spacing: .08em;
}

.step strong {
  color: #374151;
  font-size: 10px;
  margin-top: 4px;
}

.step small {
  color: #9aa1ad;
  font-size: 8px;
  margin-top: 3px;
  line-height: 1.4;
}

.stepArrow {
  position: absolute;
  right: -7px;
  top: 50%;
  transform: translateY(-50%);
  width: 14px;
  height: 14px;
  display: grid;
  place-items: center;
  background: #fff;
  color: #c1c7d0;
  font-size: 10px;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: .45;
    transform: scale(.8);
  }
}

@media (max-width: 1050px) {
  .sidebar {
    width: 210px;
  }

  .main {
    padding: 25px;
  }

  .pipeline {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .pipelineTitle {
    grid-column: 1 / -1;
  }
}

@media (max-width: 800px) {
  .factory {
    display: block;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid #e7e9ee;
  }

  .sidebar nav {
    display: flex;
    gap: 5px;
  }

  .navSection {
    display: none;
  }

  .sidebarBottom {
    display: none;
  }

  .workspace {
    grid-template-columns: 1fr;
  }

  .hero {
    margin-top: 45px;
  }

  .promptFooter {
    align-items: flex-end;
    gap: 12px;
  }

  .promptInfo {
    flex-wrap: wrap;
  }

  .pipeline {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 550px) {
  .main {
    padding: 20px 14px 40px;
  }

  .topbar {
    align-items: flex-start;
    gap: 15px;
  }

  .connection {
    font-size: 8px;
  }

  .hero h2 {
    font-size: 38px;
  }

  .promptBox textarea {
    min-height: 130px;
  }

  .promptFooter {
    flex-direction: column;
    align-items: stretch;
  }

  .buildButton {
    justify-content: center;
  }

  .previewActions span {
    display: none;
  }

  .previewFrameWrap,
  .livePreviewFrame {
    min-height: 400px;
    height: 400px;
  }

  .pipeline {
    grid-template-columns: 1fr;
  }

  .step {
    border-left: 0;
    border-top: 1px solid #eef0f3;
    padding: 12px 0;
  }

  .stepArrow {
    display: none;
  }
}
